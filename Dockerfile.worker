# Worker image for `runtime.execution: container`.
#
# One container per project runs `sleep infinity`; every task is a separate
# `docker exec bun /app/apps/cairn/src/cli.ts worker --task <task.json>`.
#
# The image ships a reviewable baseline toolset: curl/wget, nmap/netcat/socat,
# DNS and routing probes, python3, git/jq/unzip, plus ripgrep/fd for the agent's own
# grep/find tools. Add engagement-specific exploit tooling here so it stays auditable.
# `procps` is required for task-level termination (pkill).
#
#   docker build -f Dockerfile.worker -t cairn-worker:latest .
#
# The agent config directory is mounted read-only at /cairn/agent-config by the control
# plane; credentials never enter the image or the workspace.

# Override for air-gapped or mirrored registries:
#   docker build --build-arg BUN_IMAGE=<mirror>/oven/bun:1.4 -f Dockerfile.worker .
ARG BUN_IMAGE=oven/bun:1.4
FROM ${BUN_IMAGE}

WORKDIR /app

RUN apt-get update \
 && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      procps ca-certificates \
      curl wget \
      nmap netcat-openbsd socat openssh-client \
      dnsutils iputils-ping traceroute net-tools whois \
      python3 python3-pip \
      git jq unzip file xxd \
      ripgrep fd-find \
 && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
 && rm -rf /var/lib/apt/lists/*

COPY . .
RUN bun install --frozen-lockfile

RUN mkdir -p /cairn/workspace /cairn/agent-config

WORKDIR /cairn/workspace
ENV CAIRN_AGENT_CONFIG_DIR=/cairn/agent-config
ENV CAIRN_AGENT_CONFIG_READONLY=1

CMD ["sleep", "infinity"]
