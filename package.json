{
  "name": "cairnweave",
  "version": "0.75.0-m51",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "cairn": "bun run apps/cairn/src/cli.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "eval": "bun run tools/eval/run.ts",
    "eval:context": "bun run tools/eval/context.ts",
    "eval:context-pack": "bun run tools/eval/context-pack.ts",
    "eval:experiments": "bun run tools/eval/experiments.ts",
    "ui:css": "tailwindcss -c tools/ui/tailwind.config.mjs -i tools/ui/input.css -o apps/cairn/src/http/static/app.css --minify",
    "ui:css:check": "bun run ui:css && git diff --exit-code -- apps/cairn/src/http/static/app.css"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "tailwindcss": "3.4.16",
    "typescript": "^7.0.2"
  }
}
